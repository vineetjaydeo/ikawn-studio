# iKawn Studio configuration. Copy to .env and fill in. Never commit .env.
# --- Keys (bring your own; you pay the providers directly) ---
# required to generate (runware.ai). On public hosts leave empty and set IKAWN_BYOK_ONLY=1
RUNWARE_API_KEY=
# optional: use your ElevenLabs cloned voices (CLI/agent API)
ELEVENLABS_API_KEY=
# --- Behaviour ---
# runware | mock (offline test mode, returns sample clips, $0)
STUDIO_PROVIDER=runware
# USD cap per video; requests estimated above this are refused (HTTP 402 / CLI exit 3)
IKAWN_MAX_SPEND=0.50
# 1 = never use the server key, require each user's key, disable /v1 agent API (public hosts)
IKAWN_BYOK_ONLY=0
# max photo/video upload size
IKAWN_MAX_UPLOAD_MB=60
# whisper (local faster-whisper word timings) | proportional (timed from script)
IKAWN_CAPTIONS=whisper
# tiny | base | small ... (CPU)
IKAWN_WHISPER_MODEL=base
# set 16:9 for landscape photo avatars
IKAWN_ASPECT=9:16
# avatars, rendered videos, cost ledger (CLI / agent API)
IKAWN_HOME=./data
# web UI outputs
STUDIO_MEDIA=./media
# Docker / hosting port (Hugging Face Spaces uses 7860)
PORT=8000
# Pronunciation map for TTS (captions keep script spelling). Default includes iKawn=Eye-kon.
IKAWN_PRONOUNCE=
# optional JSON file {"Word": "respelling"}
IKAWN_PRONOUNCE_FILE=
